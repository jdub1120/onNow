# ignore the following folders
/docker-data
/node_modules
# Legacy cache location (optional local data); use config/cache/ instead
/saved/**
/config/cache/**
!/config/cache/.keep
/config/*.json
/dist
/public/custom/**

# any excluded dir with a .keep file. Will stay in github, but all other files will not :)
!.keep
!/public/custom/pictures
!/public/custom/pictures/default
!/public/custom/pictures/readme.txt
!/public/custom/custom.css

# Ads + custom pictures live under config/ (served at /custom/ads and /custom/pictures)
/config/ads/**
!/config/ads/.keep
/config/custom-pictures/**
!/config/custom-pictures/.keep
!/config/custom-pictures/default/.keep

# Local dev-only Apple TV sidecar venv (Docker builds its own; see Dockerfile)
/.appletv-venv/

# Runtime data — personal library/poster metadata, holiday cache, now-showing list, and the
# single-instance lock file. Never meant to be committed; historical tracking in this repo's
# git history predates this rule and is being cleaned up.
/config/*.db
/config/posterr-app.lock

# Python bytecode cache (Apple TV sidecar) and one-off local script output
__pycache__/
*.pyc
/scripts/plex_poster_fix_summary.json
